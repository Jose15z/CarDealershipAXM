{
  "name": "la-subasta-axm",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "RUN_DB_TESTS=1 vitest run",
    "db:import-observed": "tsx scripts/import-observed.ts docs/instagram-observed.json",
    "db:import-prices": "tsx scripts/import-price-references.ts docs/price-references.json"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@prisma/client": "6.19.3",
    "zod": "4.6.7",
    "bcryptjs": "3.0.3",
    "react-hook-form": "7.91.0",
    "@hookform/resolvers": "5.9.2",
    "lucide-react": "0.468.0",
    "motion": "12.43.0",
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "vitest": "3.2.7",
    "@playwright/test": "1.65.0",
    "tailwindcss": "4.3.5",
    "@tailwindcss/postcss": "4.3.5",
    "prettier": "3.9.10"
  }
}
