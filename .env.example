# PostgreSQL local (docker compose up -d). Cambiar para producción, usar TLS.
DATABASE_URL="postgresql://axm:local_development_only@localhost:5433/axm?schema=public"
APP_URL="http://localhost:3100"
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# Solo servidor. Usar variables secretas del proveedor; nunca NEXT_PUBLIC_.
# Elegir versión vigente y habilitada de Graph en la app de Meta.
META_GRAPH_VERSION=""
INSTAGRAM_ACCOUNT_ID=""
INSTAGRAM_ACCESS_TOKEN=""

# S3 o almacenamiento compatible con bucket/CDN público para fotografías.
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# Solo durante bootstrap autorizado. No hay cuenta ni contraseña por defecto.
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""
ADMIN_BOOTSTRAP_CONFIRM=""

# Pruebas exclusivamente en base local separada axm_e2e.
TEST_DATABASE_URL="postgresql://axm:local_development_only@localhost:5433/axm_e2e?schema=public"
